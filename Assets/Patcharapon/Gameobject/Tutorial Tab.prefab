  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\tThis category encompasses waste that is not easily decomposed and is
    not suitable for recycling. Examples are candy wrappers, foam boxes, plastic
    bags contaminated with food, and plastic candy wrappers. While these items can't
    be recycled, they should still be disposed of properly to minimize environmental
    impact."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 1db166619d5ba4bb2bf9a4cc03164a61, type: 2}
